{
  "name": "@forgedesign/cli",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "homepage": "https://useforge.design",
  "bugs": "https://github.com/fabioalencar/forgedesign/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabioalencar/forgedesign.git",
    "directory": "packages/cli"
  },
  "description": "The design record for AI-built prototypes: decisions, tasks, frozen versions and stakeholder feedback, as Markdown in your repo",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "forge": "dist/index.js"
  },
  "exports": {
    "./git": {
      "types": "./dist/git.d.ts",
      "import": "./dist/git.js"
    },
    "./todo": {
      "types": "./dist/todo.d.ts",
      "import": "./dist/todo.js"
    },
    "./file-lock": {
      "types": "./dist/file-lock.d.ts",
      "import": "./dist/file-lock.js"
    },
    "./atomic-write": {
      "types": "./dist/atomic-write.d.ts",
      "import": "./dist/atomic-write.js"
    },
    "./task-ledger": {
      "types": "./dist/task-ledger.d.ts",
      "import": "./dist/task-ledger.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./freezes": {
      "types": "./dist/freezes.d.ts",
      "import": "./dist/freezes.js"
    },
    "./comments-client": {
      "types": "./dist/comments-client.d.ts",
      "import": "./dist/comments-client.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js"
    },
    "./intake": {
      "types": "./dist/intake.d.ts",
      "import": "./dist/intake.js"
    },
    "./scenarios": {
      "types": "./dist/scenarios.d.ts",
      "import": "./dist/scenarios.js"
    },
    "./datasets": {
      "types": "./dist/datasets.d.ts",
      "import": "./dist/datasets.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./doctor": {
      "types": "./dist/doctor.d.ts",
      "import": "./dist/doctor.js"
    },
    "./comments": {
      "types": "./dist/comments.d.ts",
      "import": "./dist/comments.js"
    },
    "./init": {
      "types": "./dist/init.d.ts",
      "import": "./dist/init.js"
    },
    "./explore": {
      "types": "./dist/explore.d.ts",
      "import": "./dist/explore.js"
    },
    "./freeze-ceremony": {
      "types": "./dist/freeze-ceremony.d.ts",
      "import": "./dist/freeze-ceremony.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/embed-skills.mjs && tsup",
    "dev": "tsup --watch",
    "test": "pnpm build && vitest run",
    "typecheck": "node scripts/embed-skills.mjs && tsc --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@forgedesign/format": "workspace:*",
    "commander": "^15.0.0",
    "docx": "^9.7.1",
    "pdfkit": "^0.19.1",
    "@forgedesign/scenarios": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/pdfkit": "^0.17.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
